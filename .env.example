# Mẫu cấu hình local; không commit file .env có giá trị thật.
POSTGRES_DB=meotdc
POSTGRES_USER=meotdc
POSTGRES_PASSWORD=REPLACE_WITH_A_RANDOM_32_CHAR_SECRET
# Local pnpm dev: set this password to the same value as POSTGRES_PASSWORD. Compose overrides DATABASE_URL.
DATABASE_URL=postgres://meotdc:REPLACE_WITH_A_RANDOM_32_CHAR_SECRET@localhost:5432/meotdc
DATABASE_POOL_MAX=20
DATABASE_SSL=false
COOKIE_SECURE=true
TRUST_PROXY_HOPS=0
MINIO_ROOT_USER=meotdc
MINIO_ROOT_PASSWORD=REPLACE_WITH_A_DIFFERENT_RANDOM_32_CHAR_SECRET
S3_ENDPOINT=http://localhost:9000
S3_ENABLED=false
S3_BUCKET=meotdc-submissions
S3_ACCESS_KEY=meotdc
S3_SECRET_KEY=REPLACE_WITH_A_DIFFERENT_RANDOM_32_CHAR_SECRET
S3_SERVER_SIDE_ENCRYPTION=false

# Google Identity Services. Dùng cùng OAuth Web Client ID cho API và giao diện;
# không dùng client secret ở trình duyệt. Bản riêng của API đặt trong apps/api/.env.
GOOGLE_CLIENT_ID=YOUR_GOOGLE_WEB_CLIENT_ID.apps.googleusercontent.com
NEXT_PUBLIC_GOOGLE_CLIENT_ID=YOUR_GOOGLE_WEB_CLIENT_ID.apps.googleusercontent.com
MEOTDC_ADMIN_EMAIL=YOUR_ADMIN_EMAIL@tdc.edu.vn
MEOTDC_WEB_ORIGIN=http://localhost:3000
# For multiple allowed web origins, set MEOTDC_WEB_ORIGINS as a comma-separated list.
MEOTDC_DOMAINS=localhost
DOCKERHUB_USERNAME=vuongdeptraii2k8
MEOTDC_IMAGE_TAG=latest
# Thay toàn bộ các email ví dụ bằng tài khoản thuộc quyền quản lý của TDC.
MEOTDC_TEACHER_EMAILS=
MEOTDC_SCHOOL_EMAILS=
# Production class scope: email=CLASS1|CLASS2;other@tdc.edu.vn=CLASS3
MEOTDC_TEACHER_CLASS_ASSIGNMENTS=
